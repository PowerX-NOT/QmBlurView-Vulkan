#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Src {
    uint srcPixels[];
};

layout(std430, binding = 1) writeonly buffer Dst {
    uint dstPixels[];
};

layout(push_constant) uniform Push {
    int srcWidth;
    int srcHeight;
    int dstWidth;
    int dstHeight;
    int step;
} pc;

const vec2 STEP_0 = vec2( 1.0, 0.0);
const vec2 STEP_1 = vec2( 0.623489802,  0.781831482);
const vec2 STEP_2 = vec2(-0.222520934,  0.974927912);
const vec2 STEP_3 = vec2(-0.900968868,  0.433883739);
const vec2 STEP_4 = vec2( 0.900968868, -0.433883739);
const vec2 STEP_5 = vec2(-0.222520934, -0.974927912);
const vec2 STEP_6 = vec2(-0.623489802, -0.781831482);

int clampi(int v, int lo, int hi) {
    return clamp(v, lo, hi);
}

vec4 unpackColor(uint p) {
    return vec4(
        float(p & 0xffu),
        float((p >> 8) & 0xffu),
        float((p >> 16) & 0xffu),
        float((p >> 24) & 0xffu)
    );
}

uint packColor(vec4 c) {
    uvec4 uc = uvec4(clamp(c + 0.5, vec4(0.0), vec4(255.0)));
    return uc.x | (uc.y << 8) | (uc.z << 16) | (uc.w << 24);
}

vec4 sampleSrc(int x, int y) {
    x = clampi(x, 0, pc.srcWidth - 1);
    y = clampi(y, 0, pc.srcHeight - 1);
    return unpackColor(srcPixels[y * pc.srcWidth + x]);
}

vec4 tap(vec2 stepDir, int baseX, int baseY, int s) {
    ivec2 p = ivec2(round(stepDir * float(s)));
    return sampleSrc(baseX + p.x, baseY + p.y);
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.dstWidth || y >= pc.dstHeight) return;

    int baseX = x / 2;
    int baseY = y / 2;
    int s = max(pc.step, 1);

    vec4 c = sampleSrc(baseX, baseY);
    c += tap(STEP_0, baseX, baseY, s);
    c += tap(STEP_1, baseX, baseY, s);
    c += tap(STEP_2, baseX, baseY, s);
    c += tap(STEP_3, baseX, baseY, s);
    c += tap(STEP_4, baseX, baseY, s);
    c += tap(STEP_5, baseX, baseY, s);
    c += tap(STEP_6, baseX, baseY, s);
    c *= 0.125;

    dstPixels[y * pc.dstWidth + x] = packColor(c);
}

